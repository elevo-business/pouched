[
  {
    "name": "theme_info",
    "theme_name": "Pouched",
    "theme_version": "1.0.0",
    "theme_author": "Elevo",
    "theme_documentation_url": "https://shopify.dev/docs/themes",
    "theme_support_url": "https://shopify.dev"
  },
  {
    "name": "Brand",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo image" },
      { "type": "text", "id": "logo_text", "label": "Logo text", "default": "pouched." },
      { "type": "range", "id": "logo_size", "min": 16, "max": 40, "step": 1, "unit": "px", "label": "Logo text size", "default": 27 },
      { "type": "image_picker", "id": "favicon", "label": "Favicon" }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "header", "content": "Base" },
      { "type": "color", "id": "color_bg", "label": "Background", "default": "#FBF6F1" },
      { "type": "color", "id": "color_bg_soft", "label": "Soft background (blush)", "default": "#FCEFEA" },
      { "type": "color", "id": "color_text", "label": "Text", "default": "#2A211E" },
      { "type": "color", "id": "color_muted", "label": "Muted text", "default": "#8A7A73" },
      { "type": "color", "id": "color_line", "label": "Borders", "default": "#EADFD7" },
      { "type": "header", "content": "Accent" },
      { "type": "color", "id": "color_accent", "label": "Accent", "default": "#C86A5E" },
      { "type": "color", "id": "color_accent_dark", "label": "Accent (buttons)", "default": "#A2483D" },
      { "type": "color", "id": "color_button_text", "label": "Button text", "default": "#FFFFFF" },
      { "type": "color", "id": "color_dark", "label": "Dark sections (footer)", "default": "#2A211E" }
    ]
  },
  {
    "name": "Typography",
    "info": "Keep it simple — one or two clean sans fonts.",
    "settings": [
      { "type": "font_picker", "id": "font_heading", "label": "Heading font", "default": "poppins_n6" },
      { "type": "font_picker", "id": "font_body", "label": "Body font", "default": "assistant_n4" },
      { "type": "select", "id": "heading_transform", "label": "Heading case", "options": [
        { "value": "none", "label": "Normal" }, { "value": "uppercase", "label": "UPPERCASE" } ], "default": "none" },
      { "type": "range", "id": "heading_spacing", "min": -4, "max": 2, "step": 0.5, "unit": "%", "label": "Heading letter-spacing", "default": -2 }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "min": 1000, "max": 1500, "step": 20, "unit": "px", "label": "Page width", "default": 1140 },
      { "type": "range", "id": "radius", "min": 0, "max": 30, "step": 2, "unit": "px", "label": "Corner radius", "default": 18 }
    ]
  },
  {
    "name": "Product page",
    "settings": [
      { "type": "checkbox", "id": "show_express", "label": "Show express checkout buttons", "default": true },
      { "type": "checkbox", "id": "show_urgency", "label": "Show low-stock / urgency", "default": true },
      { "type": "checkbox", "id": "show_trust", "label": "Show trust badges", "default": true }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      { "type": "checkbox", "id": "cart_drawer", "label": "Open cart as drawer", "default": true },
      { "type": "text", "id": "free_ship_text", "label": "Free-shipping note", "default": "Kostenloser Versand ab 50 €" }
    ]
  }
]
