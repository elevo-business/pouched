<section class="section cta-sec">
  <div class="wrap" data-reveal>
    <h2 class="h1">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="sub" style="margin-top:14px">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <p style="margin-top:26px"><a href="{{ section.settings.button_link }}" class="btn btn--big">{{ section.settings.button_label }}</a></p>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lass die Tasche zuhause." },
    { "type": "text", "id": "text", "label": "Text", "default": "Alles Wichtige sitzt schon an deinem Handy." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Jetzt sichern" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "CTA" } ]
}
{% endschema %}
