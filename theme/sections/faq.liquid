<section class="section" id="faq" style="background:{{ section.settings.bg }}">
  <div class="wrap center">
    <h2 class="h2" data-reveal>{{ section.settings.heading }}</h2>
    <div class="faq" data-reveal>
      {%- for block in section.blocks -%}
        <details {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.q }}</summary>
          <p>{{ block.settings.a }}</p>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Häufige Fragen" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FCEFEA" }
  ],
  "blocks": [
    { "type": "qa", "name": "Question", "settings": [
      { "type": "text", "id": "q", "label": "Question", "default": "Passt es auf mein iPhone?" },
      { "type": "textarea", "id": "a", "label": "Answer", "default": "Verfügbar für iPhone 13 bis 17 (inkl. Plus, Pro & Pro Max)." }
    ]}
  ],
  "presets": [ { "name": "FAQ", "blocks": [
    { "type": "qa", "settings": { "q": "Passt es auf mein iPhone?", "a": "Verfügbar für iPhone 13 bis 17 (inkl. Plus, Pro & Pro Max). Dein Modell wählst du oben aus." } },
    { "type": "qa", "settings": { "q": "Wie viel passt in das Fach?", "a": "Bis zu 4 Karten plus Schlüssel und etwas Cash — oder deine AirPods." } },
    { "type": "qa", "settings": { "q": "Kann ich kabellos laden?", "a": "Ja, MagSafe und Qi kompatibel. Die Hülle bleibt beim Laden drauf." } },
    { "type": "qa", "settings": { "q": "Versand & Rückgabe?", "a": "Versand in 1–2 Werktagen, gratis ab 50 €. 30 Tage Geld-zurück." } }
  ]}]
}
{% endschema %}
