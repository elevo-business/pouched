<section class="section"><div class="wrap">
  <h1 class="h2" style="margin-bottom:8px">{{ collection.title | default: 'Alle Produkte' }}</h1>
  <p class="muted" style="margin-bottom:32px">{{ collection.products_count }} Produkte</p>
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
    {%- for product in collection.products -%}
      <a href="{{ product.url }}" style="text-decoration:none;color:inherit">
        <div style="border-radius:var(--radius);overflow:hidden;background:var(--bg-soft);aspect-ratio:1;margin-bottom:12px">
          {%- if product.featured_media -%}<img src="{{ product.featured_media | image_url: width: 500 }}" alt="{{ product.title | escape }}" style="width:100%;height:100%;object-fit:cover">{%- endif -%}
        </div>
        <b>{{ product.title }}</b>
        <div class="muted">{{ product.price | money }}</div>
      </a>
    {%- else -%}
      <p class="muted">Noch keine Produkte.</p>
    {%- endfor -%}
  </div>
</div></section>
{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
