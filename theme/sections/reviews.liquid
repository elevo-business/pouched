<section class="section" id="reviews">
  <div class="wrap">
    <div class="center" data-reveal style="margin-bottom:10px">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
    </div>
    <div class="rv__top" data-reveal>
      <div class="rv__score center">
        <b>{{ section.settings.rating_value }}</b>
        <div><span class="stars" data-stars="5"></span></div>
        <p>{{ section.settings.rating_count }} verifizierte Bewertungen</p>
      </div>
      <div class="rv__bars">
        {%- assign bars = '92,6,1,1,0' | split: ',' -%}
        {%- assign labels = '5,4,3,2,1' | split: ',' -%}
        {%- for b in bars -%}
          <div class="rv__bar"><span class="t">{{ labels[forloop.index0] }} ★</span><span class="track"><i style="width:{{ b }}%"></i></span><span>{{ b }}%</span></div>
        {%- endfor -%}
      </div>
    </div>
    <div class="rv__grid">
      {%- for block in section.blocks -%}
        <div class="rvc" data-reveal {{ block.shopify_attributes }}>
          <div class="rvc__img">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 500 }}" alt="" loading="lazy">
            {%- else -%}
              <div style="width:100%;height:100%;background:var(--bg-soft)"></div>
            {%- endif -%}
            <span class="stars" data-stars="5"></span>
          </div>
          <div class="rvc__b"><p>{{ block.settings.text }}</p><div class="who">{{ block.settings.name }} <span class="v">✓ Verifiziert</span></div></div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Von Frauen geliebt" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Über 12.000 mal ♡" },
    { "type": "text", "id": "rating_value", "label": "Rating value", "default": "4,9" },
    { "type": "text", "id": "rating_count", "label": "Rating count", "default": "12.480" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Endlich keine Tasche mehr! Alles hinten drin." },
      { "type": "text", "id": "name", "label": "Name", "default": "Lena M." }
    ]}
  ],
  "presets": [ { "name": "Reviews", "blocks": [
    { "type": "review", "settings": { "text": "Endlich keine Tasche mehr! Alles hinten drin — Karte, Schlüssel, Lippi.", "name": "Lena M." } },
    { "type": "review", "settings": { "text": "Fühlt sich richtig hochwertig an und die Farbe ist ein Traum.", "name": "Sophie K." } },
    { "type": "review", "settings": { "text": "Auf Festivals unbezahlbar. Hände frei tanzen. Direkt drei bestellt.", "name": "Marie T." } },
    { "type": "review", "settings": { "text": "Trage sie jeden Tag. Das Fach ist genau richtig groß.", "name": "Jana R." } }
  ]}]
}
{% endschema %}
