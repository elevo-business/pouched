<section class="section"><div class="wrap" style="max-width:800px">
  <h1 class="h2" style="margin-bottom:20px">Suche</h1>
  <form action="{{ routes.search_url }}" method="get" style="display:flex;gap:10px;margin-bottom:30px">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Suchen…" style="flex:1;padding:14px 18px;border:1px solid var(--line);border-radius:100px">
    <button class="btn" type="submit">Los</button>
  </form>
  {%- if search.performed -%}
    <p class="muted" style="margin-bottom:20px">{{ search.results_count }} Ergebnisse</p>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
      {%- for item in search.results -%}
        <a href="{{ item.url }}" style="text-decoration:none;color:inherit">
          {%- if item.featured_media -%}<div style="border-radius:var(--radius);overflow:hidden;aspect-ratio:1;background:var(--bg-soft);margin-bottom:10px"><img src="{{ item.featured_media | image_url: width: 400 }}" alt="" style="width:100%;height:100%;object-fit:cover"></div>{%- endif -%}
          <b>{{ item.title }}</b>
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div></section>
